# YouTube Data API v3 key (required)
# Get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=key

# PostgreSQL connection (used when running pipeline locally and by Airflow)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://yt_trends:yt_trends@localhost:5432/yt_trends

# Regions to fetch trending videos (comma-separated ISO 3166-1 alpha-2 codes)
# Examples: US, BR, GB, JP, IN
REGIONS=US,BR

# Path for raw JSON bronze layer (relative to project root or absolute)
RAW_DATA_PATH=./data/raw

# Max comments to fetch per video
MAX_COMMENTS_PER_VIDEO=50
